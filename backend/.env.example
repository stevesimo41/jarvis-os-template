# JARVIS OS Environment Configuration
# Copy this to .env and fill in your settings

# LLM Provider — choose one: ollama, openai, gemini, groq, or leave empty for rule-based
JARVIS_LLM_PROVIDER=ollama
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# GROQ_API_KEY=...

# Network
JARVIS_HOST=127.0.0.1
# JARVIS_ALLOWED_HOSTS=your-local-ip

# Email (optional — for outreach campaigns)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your-app-password
# SMTP_FROM=Your Name <your@email.com>

# Lemon Squeezy (optional — for selling products/templates)
# LEMON_SQUEEZY_API_KEY=...
# LEMON_SQUEEZY_STORE_ID=...
# LEMON_SQUEEZY_WEBHOOK_SECRET=...
