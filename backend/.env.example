# JARVIS OS Configuration
# Copy this to .env and fill in your values

# === SERVER ===
PORT=3000
JARVIS_HOST=127.0.0.1
JARVIS_ALLOWED_HOSTS=localhost,127.0.0.1

# === LLM — Connect with API key to your AI partner of choice ===
# Supported: gemini, openai, anthropic, ollama (local)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# OLLAMA_BASE_URL=http://localhost:11434

# === GOOGLE SHEETS (optional — for CRM) ===
# GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id
# GOOGLE_OAUTH_CLIENT_PATH=~/.jarvis/credentials/google-oauth-client.json
# GOOGLE_OAUTH_TOKEN_PATH=~/.jarvis/credentials/google-oauth-token.json

# === EMAIL (optional — for outreach) ===
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=Your Name <your-email@gmail.com>

# === AUTH ===
# Tokens are auto-generated by setup.sh
JARVIS_OWNER_TOKEN=generate-one-with-command-above
JARVIS_OPERATOR_TOKEN=generate-one-with-command-above
JARVIS_VIEWER_TOKEN=generate-one-with-command-above

# === MARKET PULSE ===
JARVIS_MARKET_PULSE_STATE=./data/agents/market-pulse-state.json
