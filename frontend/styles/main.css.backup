* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --bg: #080b10;
    --panel: #0d1118;
    --panel-light: #121821;
    --panel-hover: #171f2a;
    --border: #202936;
    --border-light: #2b3746;
    --text: #edf3f9;
    --muted: #8190a2;
    --blue: #4da3ff;
    --blue-bright: #79bdff;
    --green: #31d07c;
    --yellow: #e8c35a;
    --orange: #ff914d;
    --purple: #9d7aff;
}

html,
body {
    width: 100%;
    height: 100%;
    overflow: hidden;
}

body {
    font-family:
        Inter,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Arial,
        sans-serif;

    background: var(--bg);
    color: var(--text);
}

button,
textarea {
    font-family: inherit;
}

#app {
    display: grid;
    grid-template-columns: 235px minmax(500px, 1fr) 315px;
    width: 100vw;
    height: 100vh;
    background: var(--bg);
}


/* SIDEBAR */

#sidebar {
    display: flex;
    flex-direction: column;
    background: #090c11;
    border-right: 1px solid var(--border);
    padding: 24px 16px;
}

.brand {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 8px 22px;
}

.brand-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--blue);
    border-radius: 10px;
    color: var(--blue-bright);
    font-size: 22px;
    font-weight: 700;
    box-shadow: 0 0 18px rgba(77,163,255,.15);
}

.brand h1 {
    font-size: 20px;
    letter-spacing: 3px;
}

.brand span {
    display: block;
    margin-top: 3px;
    color: var(--muted);
    font-size: 8px;
    letter-spacing: 2px;
}

.system-status {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 8px 24px;
    padding: 9px 11px;
    border: 1px solid rgba(49,208,124,.2);
    border-radius: 7px;
    color: var(--green);
    background: rgba(49,208,124,.05);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
}

.status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 8px rgba(49,208,124,.8);
}

#mainNavigation {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.nav-button {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 11px 12px;
    border: 1px solid transparent;
    border-radius: 7px;
    background: transparent;
    color: var(--muted);
    text-align: left;
    cursor: pointer;
    transition: all .15s ease;
}

.nav-button span {
    width: 18px;
    color: #627286;
    text-align: center;
}

.nav-button:hover {
    background: var(--panel-hover);
    color: var(--text);
}

.nav-button.active {
    border-color: rgba(77,163,255,.25);
    background: rgba(77,163,255,.08);
    color: var(--blue-bright);
}

.nav-button.active span {
    color: var(--blue);
}

.sidebar-footer {
    margin-top: auto;
    padding: 16px 8px 0;
    border-top: 1px solid var(--border);
}

.connection-label {
    margin-bottom: 12px;
    color: var(--muted);
    font-size: 8px;
    letter-spacing: 1.5px;
}

.connection-label strong {
    display: block;
    margin-top: 4px;
    color: #aab6c4;
    font-size: 10px;
    letter-spacing: 0;
}


/* WORKSPACE */

#workspace {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background:
        radial-gradient(
            circle at 50% 0%,
            rgba(30,80,130,.08),
            transparent 35%
        ),
        var(--bg);
}

#topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 78px;
    padding: 18px 28px;
    border-bottom: 1px solid var(--border);
}

.eyebrow {
    margin-bottom: 5px;
    color: var(--muted);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 2px;
}

#topbar h2 {
    font-size: 20px;
    font-weight: 500;
}

.topbar-right {
    display: flex;
    align-items: center;
    gap: 18px;
}

.system-clock {
    color: var(--muted);
    font-family: monospace;
    font-size: 12px;
}

.health-badge {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 7px 10px;
    border: 1px solid rgba(49,208,124,.2);
    border-radius: 6px;
    color: var(--green);
    background: rgba(49,208,124,.04);
    font-size: 9px;
    letter-spacing: 1px;
}

#conversation {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 28px;
}

#dashboardRoot {
    max-width: 1200px;
    margin: 0 auto;
}

.loading-state {
    padding: 25px;
    color: var(--muted);
    text-align: center;
}


/* DASHBOARD */

.dashboard-header {
    margin-bottom: 25px;
}

.dashboard-header h1 {
    margin-bottom: 7px;
    font-size: 26px;
    font-weight: 500;
}

.dashboard-header p {
    color: var(--muted);
    font-size: 13px;
}

.dashboard-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
}

.dashboard-card {
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: rgba(13,17,24,.9);
}

.dashboard-card:hover {
    border-color: var(--border-light);
}

.dashboard-card.wide {
    grid-column: span 2;
}

.card-label {
    margin-bottom: 12px;
    color: var(--muted);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 1.5px;
}

.dashboard-card h2 {
    margin-bottom: 9px;
    font-size: 18px;
    font-weight: 500;
}

.dashboard-card p {
    color: #9aa8b7;
    font-size: 12px;
    line-height: 1.6;
}

.score {
    display: inline-block;
    margin-top: 12px;
    color: var(--blue-bright);
    font-size: 12px;
    font-weight: 600;
}

.execution-list {
    display: grid;
    gap: 8px;
    list-style: none;
}

.execution-list li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px;
    border-radius: 6px;
    background: rgba(255,255,255,.025);
    color: #b6c2cf;
    font-size: 12px;
}

.execution-list li::before {
    content: "→";
    color: var(--blue);
}

.pipeline {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 8px;
    margin-top: 12px;
}

.pipeline-step {
    padding: 12px 8px;
    border: 1px solid var(--border);
    border-radius: 7px;
    text-align: center;
    background: rgba(255,255,255,.02);
}

.pipeline-step .step-icon {
    margin-bottom: 6px;
    color: var(--green);
}

.pipeline-step strong {
    display: block;
    color: #c4ced9;
    font-size: 10px;
    font-weight: 500;
}

.pipeline-step span {
    display: block;
    margin-top: 4px;
    color: var(--muted);
    font-size: 8px;
}


/* COMMAND BAR */

#commandBar {
    padding: 14px 28px 18px;
    border-top: 1px solid var(--border);
    background: rgba(9,12,17,.95);
}

.command-wrapper {
    display: flex;
    gap: 10px;
}

#command {
    flex: 1;
    min-height: 44px;
    max-height: 100px;
    padding: 13px 15px;
    border: 1px solid var(--border-light);
    border-radius: 8px;
    outline: none;
    resize: none;
    background: var(--panel);
    color: var(--text);
    font-size: 13px;
}

#command:focus {
    border-color: rgba(77,163,255,.6);
}

#sendCommand {
    width: 90px;
    border: 1px solid rgba(77,163,255,.4);
    border-radius: 8px;
    background: rgba(77,163,255,.12);
    color: var(--blue-bright);
    cursor: pointer;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
}

#sendCommand:hover {
    background: rgba(77,163,255,.2);
}

.command-hint {
    margin-top: 7px;
    color: #596879;
    font-size: 9px;
}


/* INTELLIGENCE PANEL */

#intelligencePanel {
    overflow-y: auto;
    padding: 24px 18px;
    border-left: 1px solid var(--border);
    background: #090c11;
}

.panel-header {
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border);
}

.panel-header h2 {
    font-size: 17px;
    font-weight: 500;
}

.intelligence-section {
    padding: 18px 0;
    border-bottom: 1px solid var(--border);
}

.section-label {
    margin-bottom: 10px;
    color: var(--muted);
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 1.5px;
}

.intelligence-card,
.next-action-card {
    padding: 13px;
    border: 1px solid var(--border);
    border-radius: 7px;
    background: var(--panel);
    color: #aebbc8;
    font-size: 11px;
    line-height: 1.5;
}

.intelligence-card strong {
    display: block;
    margin-bottom: 4px;
    color: var(--text);
    font-size: 12px;
}

.next-action-card {
    border-color: rgba(77,163,255,.25);
    color: var(--blue-bright);
}

.agent-card {
    margin-bottom: 7px;
    padding: 11px;
    border: 1px solid var(--border);
    border-radius: 7px;
    background: var(--panel);
    cursor: pointer;
}

.agent-card:hover {
    border-color: rgba(77,163,255,.3);
}

.agent-card h3 {
    margin-bottom: 4px;
    color: #d8e2ec;
    font-size: 11px;
    font-weight: 500;
}

.agent-card p {
    color: var(--muted);
    font-size: 9px;
}

.activity-item {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 9px;
    color: #7e8d9d;
    font-size: 10px;
}

.activity-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--blue);
}


/* RESPONSIVE */

@media (max-width: 1100px) {

    #app {
        grid-template-columns: 210px 1fr;
    }

    #intelligencePanel {
        display: none;
    }

}

@media (max-width: 750px) {

    #app {
        display: block;
    }

    #sidebar {
        display: none;
    }

    .dashboard-grid {
        grid-template-columns: 1fr;
    }

    .dashboard-card.wide {
        grid-column: span 1;
    }

    .pipeline {
        grid-template-columns: repeat(2, 1fr);
    }

}

.module-shell {
    width: 100%;
    animation: moduleFadeIn 0.25s ease;
}

.module-hero {
    padding: 32px 36px;
    margin-bottom: 24px;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 18px;
    background: linear-gradient(
        135deg,
        rgba(255,255,255,0.055),
        rgba(255,255,255,0.018)
    );
    box-shadow: 0 18px 50px rgba(0,0,0,0.18);
}

.module-hero h1 {
    margin: 8px 0 10px;
    font-size: 32px;
    letter-spacing: -0.8px;
}

.module-hero p {
    max-width: 760px;
    margin: 0;
    color: rgba(255,255,255,0.62);
    line-height: 1.7;
}

.module-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
}

.module-grid .dashboard-card {
    min-height: 190px;
}

@keyframes moduleFadeIn {
    from {
        opacity: 0;
        transform: translateY(6px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@media (max-width: 1100px) {
    .module-grid {
        grid-template-columns: 1fr;
    }
}


.agent-registry {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
}

.agent-registry-card {
    text-align: left;
    cursor: pointer;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.025);
    padding: 22px;
    border-radius: 14px;
    color: inherit;
    transition: all 0.2s ease;
}

.agent-registry-card:hover {
    transform: translateY(-3px);
    border-color: rgba(255,255,255,0.2);
    background: rgba(255,255,255,0.05);
}

.agent-card-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 14px;
}

.agent-icon {
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: rgba(255,255,255,0.06);
}

.agent-registry-card h3 {
    margin: 0 0 5px;
}

.agent-status {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0.6;
}

.agent-registry-card p {
    opacity: 0.7;
    line-height: 1.5;
    min-height: 48px;
}

.agent-card-action {
    margin-top: 18px;
    font-size: 11px;
    letter-spacing: 1px;
    opacity: 0.7;
}

.agent-capabilities {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 12px;
}

.capability-card {
    padding: 16px;
    border-radius: 10px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.06);
}

.secondary-button {
    margin-top: 20px;
    padding: 12px 18px;
    cursor: pointer;
}


/* =========================================
   JARVIS INTELLIGENCE MODULES
   ========================================= */

.executive-center,
.chief-center,
.memory-center,
.mission-center {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
}

.module-header {
    margin-bottom: 28px;
}

.module-header h1 {
    margin: 6px 0 8px;
}

.module-header .subtitle {
    max-width: 760px;
}

.module-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-bottom: 22px;
}

.module-card {
    padding: 24px;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.025);
    transition: all 0.2s ease;
}

.module-card:hover {
    border-color: rgba(255,255,255,0.16);
    background: rgba(255,255,255,0.04);
}

.module-card.primary {
    border-color: rgba(255,255,255,0.16);
    background: rgba(255,255,255,0.045);
}

.module-card h2 {
    margin: 8px 0 12px;
}

.module-card h3 {
    margin: 0 0 12px;
}

.module-card p {
    line-height: 1.6;
    opacity: 0.75;
}

.module-card ul,
.module-card ol {
    padding-left: 20px;
    line-height: 1.8;
}

.module-card li {
    margin-bottom: 8px;
}

.module-score {
    display: inline-block;
    margin-top: 8px;
    padding: 6px 10px;
    border-radius: 6px;
    background: rgba(255,255,255,0.06);
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
}

.module-list-item {
    padding: 14px 0;
    border-bottom: 1px solid rgba(255,255,255,0.06);
}

.module-list-item:last-child {
    border-bottom: none;
}

.module-list-item strong {
    display: block;
    margin-bottom: 4px;
}

.module-list-item span {
    opacity: 0.7;
    line-height: 1.5;
}

.module-full {
    grid-column: 1 / -1;
}

.module-loading {
    padding: 60px;
    text-align: center;
    opacity: 0.7;
}

.module-error {
    padding: 40px;
    border-radius: 14px;
    border: 1px solid rgba(255,80,80,0.2);
    background: rgba(255,80,80,0.04);
}

@media (max-width: 800px) {

    .module-grid {
        grid-template-columns: 1fr;
    }

    .module-full {
        grid-column: auto;
    }

}


.agent-status-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid rgba(255,255,255,0.06);
}

.agent-status-row:last-child {
    border-bottom: none;
}

.agent-status-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
}

.agent-status-info strong {
    color: #f5f7fa;
    font-size: 14px;
}

.agent-status-label {
    color: #8d96a3;
    font-size: 11px;
}

.agent-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    white-space: nowrap;
}

.agent-status-pill.active {
    color: #63e6a5;
    background: rgba(49, 196, 141, 0.12);
    border: 1px solid rgba(49, 196, 141, 0.28);
}

.agent-status-pill.issue {
    color: #f5c451;
    background: rgba(245, 196, 81, 0.12);
    border: 1px solid rgba(245, 196, 81, 0.28);
}

.agent-status-pill.inactive {
    color: #ff6b6b;
    background: rgba(255, 107, 107, 0.12);
    border: 1px solid rgba(255, 107, 107, 0.28);
}

.status-dot.active {
    background: #35d07f;
    box-shadow: 0 0 8px rgba(53, 208, 127, 0.7);
}

.status-dot.issue {
    background: #f5c451;
    box-shadow: 0 0 8px rgba(245, 196, 81, 0.7);
}

.status-dot.inactive {
    background: #ff5c5c;
    box-shadow: 0 0 8px rgba(255, 92, 92, 0.7);
}

